#!/bin/bash

echo "YouTube Analytics utility functions loaded"

,setup-venv() {
    # Check if venv exists, if not create it
    if [ ! -d "venv" ]; then
        echo "Creating virtual environment..."
        python3 -m venv venv
        source venv/bin/activate
        pip install -r requirements.txt
        echo "Virtual environment setup complete"
    else
        # Just activate if it exists
        source venv/bin/activate
        echo "Virtual environment activated"
    fi
}

,organic() {
    # Show organic traffic performance for first 30 days across all videos
    ,30-day-organic "$@"
}

,search() {
    # Show YouTube search traffic analysis
    ,setup-venv
    python main.py --search "$@"
}

,all() {
    # Run all reports (organic and search)
    ,setup-venv
    python main.py "$@"
}

,update-videos() {
    # Update complete video catalog for channel
    ,setup-venv
    python main.py --update-video-listings
}

,backfill() {
    # Backfill oldest videos complete history
    local count="${1:-10}"
    ,setup-venv
    python main.py --backfill-oldest-complete-history --max-backfill "$count"
}

,get-video() {
    # Get complete history for specific video
    local video_id="$1"
    if [ -z "$video_id" ]; then
        echo "Error: Please provide a video ID" >&2
        echo "Usage: ,get-video VIDEO_ID" >&2
        echo "Example: ,get-video Q8tw6YTD3ac" >&2
        return 1
    fi
    ,setup-venv
    python main.py --video-complete-history "$video_id"
}



