# Video Ranking Report Functions
,ranking() {
    ,setup-venv
    if [ -n "$1" ] && [[ "$1" != --* ]]; then
        # First argument is a video ID (doesn't start with --)
        python main.py --video-ranking --video-id "$1" "${@:2}"
    else
        # No video ID, use most recent with all arguments
        python main.py --video-ranking "$@"
    fi
}

,evergreen() {
    # Analyze current performance of evergreen videos (60+ days old, last 30 days traffic)
    ,setup-venv
    python main.py --evergreen "${@}"
}

,subscribers() {
    # Show subscriber growth for last 7 days (or custom date range)
    ,setup-venv
    
    # If no arguments provided, default to last 7 days
    if [ $# -eq 0 ]; then
        local end_date=$(date +%Y-%m-%d)
        local start_date=$(date -d '7 days ago' +%Y-%m-%d 2>/dev/null || date -v-7d +%Y-%m-%d 2>/dev/null)
        python main.py --subscriber-growth --start "$start_date" --end "$end_date"
    else
        python main.py --subscriber-growth "${@}"
    fi
}

