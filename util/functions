#!/bin/bash

echo "YouTube Analytics utility functions loaded"

,setup-venv() {
    # Check if venv exists, if not create it
    if [ ! -d "venv" ]; then
        echo "Creating virtual environment..."
        python3 -m venv venv
        source venv/bin/activate
        pip install -r requirements.txt
        echo "Virtual environment setup complete"
    else
        # Just activate if it exists
        source venv/bin/activate
        echo "Virtual environment activated"
    fi
}

,organic() {
    # Show organic views (excluding advertising)
    ,setup-venv
    python main.py --organic "$@"
}

,search() {
    # Show YouTube search traffic analysis
    ,setup-venv
    python main.py --search "$@"
}

,all() {
    # Run all reports (organic and search)
    ,setup-venv
    python main.py "$@"
}

,sync() {
    # Sync video data to database
    local video_id="$1"
    if [ -z "$video_id" ]; then
        echo "Error: Please provide a video ID or 'recent'" >&2
        echo "Usage: ,sync VIDEO_ID" >&2
        echo "Usage: ,sync recent" >&2
        echo "Example: ,sync Q8tw6YTD3ac" >&2
        return 1
    fi
    ,setup-venv
    python main.py --sync "$video_id" "${@:2}"
}

,first-week() {
    # Analyze first week performance by traffic source
    local traffic_source="$1"
    if [ -z "$traffic_source" ]; then
        echo "Error: Please provide a traffic source" >&2
        echo "Usage: ,first-week \"TRAFFIC_SOURCE\"" >&2
        echo "Common sources: \"Browse features\", \"YouTube search\", \"Channel pages\", \"Advertising\", \"External\"" >&2
        echo "All sources: \"Suggested videos\", \"Direct or unknown\", \"Other YouTube features\", \"Playlists\", \"Notifications\"" >&2
        return 1
    fi
    ,setup-venv
    python main.py --first-week --traffic-source "$traffic_source" "${@:2}"
}

,search-90() {
    # Analyze YouTube search performance for first 90 days
    ,setup-venv
    python main.py --first-90-days-traffic --traffic-source-90 "YouTube search" "${@}"
}

,browse-90() {
    # Analyze Browse features performance for first 90 days
    ,setup-venv
    python main.py --first-90-days-traffic --traffic-source-90 "Browse features" "${@}"
}

,external-90() {
    # Analyze External traffic performance for first 90 days
    ,setup-venv
    python main.py --first-90-days-traffic --traffic-source-90 "External" "${@}"
}

,channel-90() {
    # Analyze Channel pages traffic performance for first 90 days
    ,setup-venv
    python main.py --first-90-days-traffic --traffic-source-90 "Channel pages" "${@}"
}

,suggested-90() {
    # Analyze Suggested videos performance for first 90 days
    ,setup-venv
    python main.py --first-90-days-traffic --traffic-source-90 "Suggested videos" "${@}"
}

,all-90() {
    # Analyze ALL traffic sources performance for first 90 days
    ,setup-venv
    python main.py --first-90-days-traffic --traffic-source-90 "all" "${@}"
}

,search-180() {
    # Analyze YouTube search performance for first 180 days
    ,setup-venv
    python main.py --first-180-days-search "${@}"
}

,traffic() {
    # Show traffic breakdown for specific video and date (YouTube Studio style)
    local video_id="$1"
    local date="$2"
    if [ -z "$video_id" ] || [ -z "$date" ]; then
        echo "Error: Please provide video ID and date" >&2
        echo "Usage: ,traffic VIDEO_ID YYYY-MM-DD" >&2
        echo "Example: ,traffic AUCt28gVR6Y 2025-06-19" >&2
        return 1
    fi
    ,setup-venv
    python main.py --traffic-breakdown "$video_id,$date"
}

,help() {
    echo "YouTube Analytics Tool - Available Functions:"
    echo ""
    echo "Setup:"
    echo "  ,setup-venv          - Create/activate virtual environment"
    echo ""
    echo "Reports:"
    echo "  ,organic             - Show organic views (excluding advertising)"
    echo "  ,search              - Show YouTube search traffic analysis"
    echo "  ,all                 - Run all reports"
    echo ""
    echo "Database:"
    echo "  ,sync VIDEO_ID       - Sync specific video data"
    echo "  ,sync recent         - Sync recent videos"
    echo "  ,first-week SOURCE   - Analyze first week performance by traffic source"
    echo "  ,search-90           - Analyze YouTube search performance for first 90 days"
    echo "  ,browse-90           - Analyze Browse features performance for first 90 days"
    echo "  ,external-90         - Analyze External traffic performance for first 90 days"
    echo "  ,channel-90          - Analyze Channel pages traffic performance for first 90 days"
    echo "  ,suggested-90        - Analyze Suggested videos performance for first 90 days"
    echo "  ,all-90              - Analyze ALL traffic sources performance for first 90 days"
    echo "  ,search-180          - Analyze YouTube search performance for first 180 days"
    echo "  ,traffic VIDEO_ID DATE - Show traffic breakdown (YouTube Studio style)"
    echo ""
    echo "Examples:"
    echo "  ,organic"
    echo "  ,sync recent"
    echo "  ,sync Q8tw6YTD3ac"
    echo "  ,first-week \"YouTube search\""
    echo "  ,first-week \"Browse features\""
    echo "  ,traffic AUCt28gVR6Y 2025-06-19"
    echo ""
    echo "Common Traffic Sources:"
    echo "  \"Browse features\", \"YouTube search\", \"Channel pages\", \"Advertising\", \"External\""
    echo "All Traffic Sources:"
    echo "  \"Suggested videos\", \"Direct or unknown\", \"Other YouTube features\", \"Playlists\", \"Notifications\""
}

# Show help on load
,help
